<div class="mypage-container">
  <!-- ペンネーム -->
  <div class="penname-display">
    <%= @user.penname.presence || 'ペンネーム未設定' %>
  </div>

  <!-- メイン機能ボタン -->
  <div class="main-buttons">
    <%= link_to '作品一覧', works_path, class: 'main-btn' %>
    <%= link_to 'プロフィール変更', edit_profile_path, class: 'main-btn' %>
  </div>
</div>

<style>
  .mypage-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 40px;
    padding: 0 20px;
  }

  .penname-display {
    font-size: 2rem;
    font-weight: bold;
    margin-bottom: 40px;
    text-align: center;
  }

  .main-buttons {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: center;
    width: 100%;
    max-width: 300px;
  }

  .main-btn {
    display: block;
    width: 200px;
    padding: 12px 16px;
    border: 1px solid #333;
    background: #fff;
    border-radius: 4px;
    text-align: center;
    text-decoration: none;
    color: #333;
    font-size: 1rem;
    font-weight: normal;
    transition: background 0.2s;
  }

  .main-btn:hover {
    background: #f0f0f0;
  }
</style> 