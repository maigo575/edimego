<div class="profile-container">
  <h2 class="profile-title">プロフィール編集</h2>

  <%= form_with model: @user, url: update_profile_path, method: :patch, local: true do |f| %>
    <div class="form-container">
      <% if @user.errors.any? %>
        <div class="error-messages">
          <ul>
            <% @user.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="form-field">
        <label for="user_penname">ペンネーム</label>
        <%= f.text_field :penname, required: true, class: 'form-input' %>
      </div>

      <div class="form-field">
        <label for="user_email">メールアドレス</label>
        <%= f.email_field :email, required: true, class: 'form-input' %>
        <% if @user.respond_to?(:unconfirmed_email) && @user.unconfirmed_email.present? %>
          <div class="unconfirmed-notice">
            確認待ちの新しいメールアドレス: <strong><%= @user.unconfirmed_email %></strong><br>
            メール内のリンクから変更を確定してください。
          </div>
        <% end %>
      </div>

      <div class="form-actions">
        <%= f.submit '更新する', class: 'submit-btn' %>
      </div>
    </div>
  <% end %>

  <!-- 追加設定セクション -->
  <div class="additional-settings">
    <h3 class="settings-title">追加設定</h3>
    <div class="settings-buttons">
      <%= link_to 'メールアドレス変更', edit_email_change_path, class: 'settings-btn' %>
      <%= link_to 'パスワード変更', edit_password_change_path, class: 'settings-btn' %>
      <%= link_to '📧 メール送信テスト', new_test_mail_path, class: 'settings-btn' %>
    </div>
  </div>
</div>

<style>
  .profile-container {
    max-width: 600px;
    margin: 0 auto;
    padding: 20px;
  }

  .profile-title {
    text-align: center;
    margin-bottom: 32px;
    font-size: 1.8rem;
    color: #333;
  }

  .form-container {
    background: #fff;
    padding: 24px;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    margin-bottom: 32px;
  }

  .form-field {
    margin-bottom: 20px;
  }

  .form-field label {
    display: block;
    font-weight: bold;
    margin-bottom: 6px;
    color: #333;
  }

  .form-input {
    width: 100%;
    padding: 12px;
    font-size: 1rem;
    border-radius: 6px;
    border: 1px solid #ddd;
    transition: border-color 0.2s;
  }

  .form-input:focus {
    outline: none;
    border-color: #333;
  }

  .unconfirmed-notice {
    margin-top: 8px;
    padding: 8px 12px;
    background: #fff3cd;
    border: 1px solid #ffeaa7;
    border-radius: 4px;
    font-size: 0.9rem;
    color: #856404;
  }

  .error-messages {
    background: #f8d7da;
    border: 1px solid #f5c6cb;
    border-radius: 4px;
    padding: 12px;
    margin-bottom: 20px;
    color: #721c24;
  }

  .error-messages ul {
    margin: 0;
    padding-left: 20px;
  }

  .form-actions {
    text-align: center;
    margin-top: 24px;
  }

  .submit-btn {
    padding: 12px 32px;
    font-size: 1.1rem;
    border-radius: 8px;
    border: none;
    background: #333;
    color: #fff;
    font-weight: bold;
    cursor: pointer;
    transition: background 0.2s;
  }

  .submit-btn:hover {
    background: #555;
  }

  .additional-settings {
    background: #f8f9fa;
    padding: 24px;
    border-radius: 8px;
    border: 1px solid #e9ecef;
  }

  .settings-title {
    text-align: center;
    margin-bottom: 20px;
    font-size: 1.3rem;
    color: #333;
  }

  .settings-buttons {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .settings-btn {
    display: block;
    padding: 12px 20px;
    background: #fff;
    border: 1px solid #ddd;
    border-radius: 6px;
    text-align: center;
    text-decoration: none;
    color: #333;
    font-weight: 500;
    transition: all 0.2s;
  }

  .settings-btn:hover {
    background: #f8f9fa;
    border-color: #333;
    transform: translateY(-1px);
  }
</style> 