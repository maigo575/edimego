<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card">
        <div class="card-header">
          <h3 class="mb-0">メールアドレス変更</h3>
        </div>
        <div class="card-body">
          <% if notice %>
            <div class="alert alert-success" role="alert">
              <%= notice %>
            </div>
          <% end %>

          <% if alert %>
            <div class="alert alert-danger" role="alert">
              <%= alert %>
            </div>
          <% end %>

          <%= form_with(model: @user, url: update_email_change_path, method: :patch, local: true) do |form| %>
            <% if @user.errors.any? %>
              <div class="alert alert-danger" role="alert">
                <h4><%= pluralize(@user.errors.count, "error") %> prohibited this user from being saved:</h4>
                <ul class="mb-0">
                  <% @user.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="mb-3">
              <%= form.label :email, "新しいメールアドレス", class: "form-label" %>
              <%= form.email_field :email, class: "form-control", required: true %>
            </div>

            <div class="mb-3">
              <%= form.label :current_password, "現在のパスワード", class: "form-label" %>
              <%= form.password_field :current_password, class: "form-control", required: true, placeholder: "確認のため現在のパスワードを入力してください" %>
            </div>

            <div class="d-grid gap-2">
              <%= form.submit "メールアドレスを変更する", class: "btn btn-primary" %>
            </div>
          <% end %>

          <div class="mt-3">
            <%= link_to "戻る", mypage_path, class: "btn btn-secondary" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
