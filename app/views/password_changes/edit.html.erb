<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card">
        <div class="card-header">
          <h3 class="mb-0">パスワード変更</h3>
        </div>
        <div class="card-body">
          <% if notice %>
            <div class="alert alert-success" role="alert">
              <%= notice %>
            </div>
          <% end %>

          <% if alert %>
            <div class="alert alert-danger" role="alert">
              <%= alert %>
            </div>
          <% end %>

          <div class="alert alert-info" role="alert">
            <h5>パスワード変更手順</h5>
            <ol>
              <li>メールアドレスを入力してください</li>
              <li>パスワード変更用のリンクをメールで送信します</li>
              <li>メール内のリンクから新しいパスワードを設定してください</li>
            </ol>
          </div>

          <%= form_with(model: @user, url: update_password_change_path, method: :patch, local: true) do |form| %>
            <% if @user.errors.any? %>
              <div class="alert alert-danger" role="alert">
                <h4><%= pluralize(@user.errors.count, "error") %> prohibited this user from being saved:</h4>
                <ul class="mb-0">
                  <% @user.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="mb-3">
              <%= form.label :email, "メールアドレス", class: "form-label" %>
              <%= form.email_field :email, value: current_user.email, class: "form-control", required: true, readonly: true %>
              <div class="form-text">登録済みのメールアドレスにパスワード変更リンクを送信します</div>
            </div>

            <div class="d-grid gap-2">
              <%= form.submit "パスワード変更メールを送信", class: "btn btn-primary" %>
            </div>
          <% end %>

          <div class="mt-3">
            <%= link_to "戻る", mypage_path, class: "btn btn-secondary" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
